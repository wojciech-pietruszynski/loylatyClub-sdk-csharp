{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "restore",
      "command": "dotnet",
      "type": "process",
      "args": ["restore", "${workspaceFolder}/LoyaltyClub.Sdk.sln"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/LoyaltyClub.Sdk.sln",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "command": "dotnet",
      "type": "process",
      "args": ["test", "${workspaceFolder}/LoyaltyClub.Sdk.sln"],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "run-demo",
      "command": "dotnet",
      "type": "process",
      "args": ["run", "--project", "${workspaceFolder}/samples/LoyaltyClub.Sdk.Demo/LoyaltyClub.Sdk.Demo.csproj"],
      "problemMatcher": "$msCompile"
    }
  ]
}
