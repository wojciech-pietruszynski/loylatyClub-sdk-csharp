<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
        Odpowiednik pom.xml z SDK w Javie. Transport HTTP bierzemy z System.Net.Http w BCL,
        a JSON z System.Text.Json, wiec projekt hosta nie dostaje ani jednej zaleznosci NuGet.
    -->
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>LoyaltyClub.Sdk</PackageId>
    <Version>1.0.0</Version>
    <Authors>pietruszynski</Authors>
    <Product>LoyaltyClub .NET SDK</Product>
    <Description>SDK w czystym .NET do API sklepowego (store) i e-commerce (ecom) programu LoyaltyClub</Description>
    <RootNamespace>LoyaltyClub.Sdk</RootNamespace>
    <AssemblyName>LoyaltyClub.Sdk</AssemblyName>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <!-- Konstruktory klientow sa internal, tak jak package-private w Javie. -->
    <InternalsVisibleTo Include="LoyaltyClub.Sdk.Tests" />
  </ItemGroup>

</Project>
